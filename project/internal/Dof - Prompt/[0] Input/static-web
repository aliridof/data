🔧 CONTOH IMPLEMENTASI NAMESPACE
js/store.js
code
JavaScript
window.App = window.App || {};
(function(ns) {
    'use strict';
    
    ns.store = {
        // State
        items: [],
        filter: 'all',
        
        // Constants
        STORAGE_KEY: 'app_data',
        MAX_ITEMS: 100,
        
        // Getters
        getFilteredItems: function() {
            return this.items.filter(/* ... */);
        },
        
        // Setters dengan validasi
        addItem: function(item) {
            if (this.items.length >= this.MAX_ITEMS) {
                throw new Error('Maximum items reached');
            }
            this.items.push(item);
            this.save();
        },
        
        // Persistence
        save: function() {
            localStorage.setItem(this.STORAGE_KEY, JSON.stringify(this.items));
        },
        
        load: function() {
            var saved = localStorage.getItem(this.STORAGE_KEY);
            this.items = saved ? JSON.parse(saved) : [];
        }
    };
    
})(window.App);
js/app.js
code
JavaScript
window.App = window.App || {};
(function(ns) {
    'use strict';
    
    ns.init = function() {
        try {
            // 1. Load data
            ns.store.load();
            
            // 2. Init modules
            ns.domain.init();
            
            // 3. Bind UI
            ns.ui.bindAll();
            
            // 4. Render initial state
            ns.domain.render();
            
            console.log('✅ App ready');
        } catch (e) {
            console.error('❌ Init failed:', e);
            ns.showError(e.message);
        }
    };
    
    ns.showError = function(msg) {
        var el = document.getElementById('app');
        if (el) {
            el.innerHTML = '<div class="error"><h2>⚠️ Error</h2><p>' + msg + '</p></div>';
        }
    };
    
})(window.App);

// Auto-init saat DOM ready
document.addEventListener('DOMContentLoaded', function() {
    window.App.init();
});
