## BAB 3: KATALOG ASPEK & SISTEM ORB

```js
// ============================================================
// BAB 3 — KATALOG ASPEK & SISTEM ORB
// ============================================================

// ------------------------------------------------------------
// 3.1 ASPEK UTAMA (IMMUTABLE)
// ------------------------------------------------------------

/**
 * AspectDef
 * @typedef {Object} AspectDef
 * @property {string}  id
 * @property {string}  name
 * @property {number}  angle   - sudut tepat (°)
 * @property {string}  symbol
 * @property {string}  color   - warna hex default sel matrix
 * @property {boolean} custom  - false untuk aspek utama
 */

/** @type {AspectDef[]} */
const ASPECTS_CORE = [
  { id:'konj', name:'Konjungsi', angle:0,   symbol:'☌', color:'#c8e6c9', custom:false },
  { id:'seks', name:'Sekstil',   angle:60,  symbol:'⚹', color:'#bbdefb', custom:false },
  { id:'kuin', name:'Kuintil',   angle:72,  symbol:'⬠', color:'#e1bee7', custom:false },
  { id:'kuad', name:'Kuadrat',   angle:90,  symbol:'□', color:'#ffcdd2', custom:false },
  { id:'trig', name:'Trigon',    angle:120, symbol:'△', color:'#fff9c4', custom:false },
  { id:'opos', name:'Oposisi',   angle:180, symbol:'☍', color:'#ffe0b2', custom:false },
];

// ------------------------------------------------------------
// 3.2 STORE ASPEK CUSTOM (MUTABLE)
// ------------------------------------------------------------

/** @type {AspectDef[]} */
let customAspects = [];

let customAspectCounter = 0;

/**
 * Menghasilkan ID unik untuk aspek custom.
 * @returns {string}
 */
function generateCustomId() {
  customAspectCounter++;
  return `cust_${String(customAspectCounter).padStart(4, '0')}`;
}

/**
 * Menambahkan aspek custom baru.
 * Memvalidasi parameter dan memeringatkan jika ada potensi konflik.
 *
 * @param {Object} params
 * @param {string} params.name
 * @param {number} params.angle   - [0, 180]
 * @param {number} params.orb     - > 0
 * @param {string} [params.symbol='◇']
 * @param {string} [params.color='#e8e8e8']
 * @param {string} [params.note='']
 * @param {OrbConfig} orbConfig   - konfigurasi ORB saat ini
 * @returns {{ ok: boolean, id?: string, warnings: string[], errors: string[] }}
 */
function addCustomAspect(params, orbConfig) {
  const errors   = [];
  const warnings = [];

  // Validasi wajib
  if (!params.name || params.name.trim() === '') {
    errors.push('name tidak boleh kosong.');
  }
  if (typeof params.angle !== 'number' || params.angle < 0 || params.angle > 180) {
    errors.push('angle harus angka antara 0 dan 180.');
  }
  if (typeof params.orb !== 'number' || params.orb <= 0) {
    errors.push('orb harus angka positif > 0.');
  }

  if (errors.length > 0) return { ok: false, errors, warnings };

  // Peringatan konflik dengan aspek yang sudah ada
  const allExisting = getAllAspects();
  for (const existing of allExisting) {
    const existingOrb = getOrb(existing.id, orbConfig);
    const gap         = Math.abs(params.angle - existing.angle);
    if (gap < (params.orb + existingOrb)) {
      warnings.push(
        `Potensi konflik dengan ${existing.name} (${existing.angle}°). ` +
        `Gap ${gap.toFixed(1)}° < total ORB ${(params.orb + existingOrb).toFixed(1)}°.`
      );
    }
  }

  const newAspect = {
    id     : generateCustomId(),
    name   : params.name.trim(),
    angle  : params.angle,
    symbol : params.symbol  || '◇',
    color  : params.color   || '#e8e8e8',
    note   : params.note    || '',
    orb    : params.orb,
    custom : true,
    active : true,
  };

  customAspects.push(newAspect);

  return { ok: true, id: newAspect.id, errors: [], warnings };
}

/**
 * Menghapus aspek custom berdasarkan ID.
 * @param {string} id
 * @returns {boolean}
 */
function removeCustomAspect(id) {
  const before = customAspects.length;
  customAspects = customAspects.filter(a => a.id !== id);
  return customAspects.length < before;
}

/**
 * Mengaktifkan atau menonaktifkan aspek custom.
 * @param {string}  id
 * @param {boolean} active
 */
function setCustomAspectActive(id, active) {
  const aspect = customAspects.find(a => a.id === id);
  if (aspect) aspect.active = active;
}

/**
 * Mengembalikan semua aspek: 6 utama + custom yang aktif.
 * @returns {AspectDef[]}
 */
function getAllAspects() {
  const activeCustom = customAspects.filter(a => a.active);
  return [...ASPECTS_CORE, ...activeCustom];
}

// ------------------------------------------------------------
// 3.3 SISTEM ORB
// ------------------------------------------------------------

/**
 * Mengambil nilai ORB untuk aspek tertentu.
 *
 * Mode 'default' : semua aspek mendapat orb_default.
 * Mode 'custom'  : setiap aspek punya ORB sendiri,
 *                  fallback ke default_value jika tidak ada.
 *
 * @param {string}    aspectId
 * @param {OrbConfig} config
 * @returns {number}
 */
function getOrb(aspectId, config) {
  if (config.mode === 'default') {
    return config.default_value;
  }
  // mode 'custom'
  const val = config.custom_values[aspectId];
  return (val !== undefined && val !== null) ? val : config.default_value;
}

/**
 * Mengubah ORB default (mode 'default').
 * Memvalidasi range dan memperingatkan jika terlalu besar.
 *
 * @param {number}    value
 * @param {OrbConfig} config     - dimodifikasi in-place
 * @returns {{ ok: boolean, warnings: string[] }}
 */
function setDefaultOrb(value, config) {
  const warnings = [];

  if (typeof value !== 'number' || value < 0.1) {
    return { ok: false, warnings: ['ORB minimum adalah 0.1°.'] };
  }
  if (value > 10.0) {
    warnings.push('ORB > 10° dianggap terlalu longgar.');
  }
  if (value > 6.0) {
    warnings.push(
      'ORB > 6° dapat menyebabkan konflik antara Sekstil (60°) ' +
      'dan Kuintil (72°) — gap hanya 12°.'
    );
  }

  config.default_value = value;
  return { ok: true, warnings };
}

/**
 * Validasi seluruh konfigurasi ORB untuk mendeteksi konflik antar aspek.
 * Mengembalikan daftar pasangan aspek yang ORB-nya overlap.
 *
 * @param {OrbConfig} config
 * @returns {Array<{ aspectA: string, aspectB: string, gap: number, totalOrb: number }>}
 */
function validateOrbConflicts(config) {
  const allAspects = getAllAspects();
  const conflicts  = [];

  for (let i = 0; i < allAspects.length; i++) {
    for (let j = i + 1; j < allAspects.length; j++) {
      const A      = allAspects[i];
      const B      = allAspects[j];
      const orbA   = getOrb(A.id, config);
      const orbB   = getOrb(B.id, config);
      const gap    = Math.abs(A.angle - B.angle);
      const total  = orbA + orbB;

      if (gap < total) {
        conflicts.push({
          aspectA  : A.name,
          aspectB  : B.name,
          gap      : gap,
          totalOrb : total,
        });
      }
    }
  }

  return conflicts;
}
