      `θ(TZ, Alt=${tc.alt < 0 ? tc.alt : '+'+tc.alt}°) = ${tc.expectedTheta}° [${tc.aspek}]`,
      approxEq(theta, tc.expectedTheta),
      `θ_aktual=${theta.toFixed(4)}°`
    );
  }
}

