## BAB 5: GREAT-CIRCLE SEPARATION

```js
// ============================================================
// BAB 5 — GREAT-CIRCLE SEPARATION
// ============================================================

/**
 * Menghitung sudut separasi Great-Circle antara dua unit vector.
 *
 * Formula:
 *   D = v1 · v2  (dot product)
 *   θ = arccos(clamp(D, -1, +1)) × (180/π)
 *
 * Rentang hasil: [0°, 180°]
 * Simetris: gcSep(A, B) === gcSep(B, A)
 *
 * @param {number[]} v1   - unit vector [x, y, z]
 * @param {number[]} v2   - unit vector [x, y, z]
 * @returns {number}      - sudut dalam derajat
 */
function gcSep(v1, v2) {
  const dot    = v1[0]*v2[0] + v1[1]*v2[1] + v1[2]*v2[2];
  const dotC   = Math.max(-1, Math.min(1, dot));   // clamp anti-NaN
  return Math.acos(dotC) * ASTRO_CONST.RAD_TO_DEG;
}

/**
 * Verifikasi bahwa vektor adalah unit vector (|v| ≈ 1).
 * Digunakan untuk debugging dan validasi pipeline.
 *
 * @param {number[]} v
 * @param {number}   [tol=1e-9]
 * @returns {boolean}
 */
function isUnitVector(v, tol = 1e-9) {
  const mag = Math.sqrt(v[0]**2 + v[1]**2 + v[2]**2);
  return Math.abs(mag - 1) < tol;
}

/**
 * Hitung θ antara TZ/TN dan suatu objek menggunakan
 * shortcut altitude (lebih cepat dari gcSep penuh).
 *
 * θ(TZ, X) = 90° - Alt_X
 * θ(TN, X) = 90° + Alt_X
 *
 * @param {boolean} isTZ    - true=TZ, false=TN
 * @param {number}  altDeg  - altitude objek X
 * @returns {number}
 */
function thetaFromAlt(isTZ, altDeg) {
  return isTZ ? (90 - altDeg) : (90 + altDeg);
}
