## BAB 10: DETEKTOR ANOMALI KUBAH

```js
// ============================================================
// BAB 10 — DETEKTOR ANOMALI KUBAH
// ============================================================

// ------------------------------------------------------------
// 10.1 TIPE DATA ANOMALI
// ------------------------------------------------------------

/**
 * IdentikGroup — kelompok pasangan dengan θ identik
 * @typedef {Object} IdentikGroup
 * @property {number}   theta      - nilai θ representatif
 * @property {Array}    pairs      - [{keyA, keyB, theta}, ...]
 * @property {number}   count
 */

/**
 * DomeAnomalyResult — hasil deteksi anomali satu kubah
 * @typedef {Object} DomeAnomalyResult
 * @property {number}         aspekCount
 * @property {boolean}        aspekFlag
 * @property {number}         identikCount    - total pasangan di grup identik
 * @property {boolean}        identikFlag
 * @property {IdentikGroup[]} identikGroups
 */

// ------------------------------------------------------------
// 10.2 DETEKSI ANOMALI TIPE 1 — KEPADATAN ASPEK
// ------------------------------------------------------------

/**
 * Menghitung anomali kepadatan aspek pada satu kubah.
 *
 * @param {MatrixCell[]} aspectCells   - sel yang memiliki aspek aktif
 * @param {number}        threshold    - N_Aspek
 * @returns {{ count: number, flag: boolean }}
 */
function detectAnomalyAspek(aspectCells, threshold) {
  const count = aspectCells.length;
  return {
    count,
    flag : count >= threshold,
  };
}

// ------------------------------------------------------------
// 10.3 DETEKSI ANOMALI TIPE 2 — SUDUT IDENTIK
// ------------------------------------------------------------

/**
 * Mengelompokkan nilai θ yang identik dalam ±tolerance.
 * Menggunakan bucketing dengan resolusi tolerance.
 *
 * @param {Array<{keyA: string, keyB: string, theta: number}>} thetaPairs
 * @param {number} tolerance   - default 0.1°
 * @returns {IdentikGroup[]}
 */
function groupIdenticalTheta(thetaPairs, tolerance = 0.1) {
  const bucketMap = new Map();

  for (const pair of thetaPairs) {
    // Pembulatan ke nearest tolerance
    const bucketKey = Math.round(pair.theta / tolerance) * tolerance;
    const keyStr    = bucketKey.toFixed(1);

    if (!bucketMap.has(keyStr)) {
      bucketMap.set(keyStr, {
        theta : bucketKey,
        pairs : [],
        count : 0,
      });
    }

    const group = bucketMap.get(keyStr);
    group.pairs.push(pair);
    group.count++;
  }

  // Hanya return grup dengan ≥ 2 pasangan (berarti ada yang identik)
  return Array.from(bucketMap.values()).filter(g => g.count >= 2);
}

/**
 * Menghitung anomali sudut identik pada satu kubah.
 *
 * @param {MatrixCell[]} activeCells     - semua sel aktif kubah
 * @param {Entity[]}      entities
 * @param {AnomalyConfig} anomalyConfig
 * @returns {{ count: number, flag: boolean, groups: IdentikGroup[] }}
 */
function detectAnomalyIdentik(activeCells, entities, anomalyConfig) {
  const { threshold, tolerance } = anomalyConfig.n_identik;

  // Kumpulkan pasangan θ dari sel aktif
  const thetaPairs = activeCells.map(cell => ({
    keyA  : entities[cell.i].key,
    keyB  : entities[cell.j].key,
    theta : cell.theta,
  }));

  const groups      = groupIdenticalTheta(thetaPairs, tolerance);
  const totalPairs  = groups.reduce((sum, g) => sum + g.count, 0);

  return {
    count  : totalPairs,
    flag   : totalPairs >= threshold,
    groups,
  };
}

// ------------------------------------------------------------
// 10.4 DETEKSI ANOMALI LENGKAP — SATU KUBAH
// ------------------------------------------------------------

/**
 * Menjalankan seluruh deteksi anomali untuk satu kubah.
 *
 * @param {MatrixCell[][]} grid
 * @param {'zenith'|'nadir'} zone
 * @param {Entity[]}     entities
 * @param {AnomalyConfig} anomalyConfig
 * @returns {DomeAnomalyResult}
 */
function detectDomeAnomaly(grid, zone, entities, anomalyConfig) {
  if (!anomalyConfig.enabled) {
    return {
      aspekCount   : 0, aspekFlag   : false,
      identikCount : 0, identikFlag : false,
      identikGroups: [],
    };
  }

  const aspectCells = getAspectCells(grid, zone);
  const activeCells = getActiveCells(grid, zone);

  // Anomali Tipe 1
  const anomalyAspek = anomalyConfig.n_aspek.enabled
    ? detectAnomalyAspek(aspectCells, anomalyConfig.n_aspek.threshold)
    : { count: 0, flag: false };

  // Anomali Tipe 2
  const anomalyIdentik = anomalyConfig.n_identik.enabled
    ? detectAnomalyIdentik(activeCells, entities, anomalyConfig)
    : { count: 0, flag: false, groups: [] };

  return {
    aspekCount    : anomalyAspek.count,
    aspekFlag     : anomalyAspek.flag,
    identikCount  : anomalyIdentik.count,
    identikFlag   : anomalyIdentik.flag,
    identikGroups : anomalyIdentik.groups,
  };
}

// ------------------------------------------------------------
// 10.5 DETEKSI ANOMALI CROSS-DOME (OPSIONAL)
// ------------------------------------------------------------

/**
 * Mendeteksi anomali pada Matriks 3 (Cross-Dome).
 *
 * @param {CrossDomeMatrix} matrix3
 * @param {AnomalyConfig}   anomalyConfig
 * @returns {DomeAnomalyResult}
 */
function detectCrossDomeAnomaly(matrix3, anomalyConfig) {
  const cdConfig = anomalyConfig.crossdome;

  if (!cdConfig.enabled) {
    return {
      aspekCount   : 0, aspekFlag   : false,
      identikCount : 0, identikFlag : false,
      identikGroups: [],
    };
  }

  const allCells = [];
  for (let r = 0; r < matrix3.R; r++) {
    for (let c = 0; c < matrix3.C; c++) {
      allCells.push(matrix3.grid[r][c]);
    }
  }

  const aspectCells   = allCells.filter(cell => cell.aspect !== null);
  const anomalyAspek  = cdConfig.n_aspek.enabled
    ? detectAnomalyAspek(aspectCells, cdConfig.n_aspek.threshold)
    : { count: 0, flag: false };

  // Siapkan thetaPairs untuk identik check
  const thetaPairs = allCells.map(cell => ({
    keyA  : cell.keyZen,
    keyB  : cell.keyNad,
    theta : cell.theta,
  }));

  const groups     = cdConfig.n_identik.enabled
    ? groupIdenticalTheta(thetaPairs, cdConfig.n_identik.tolerance)
    : [];
  const totalPairs = groups.reduce((sum, g) => sum + g.count, 0);

  const anomalyIdentik = {
    count : totalPairs,
    flag  : cdConfig.n_identik.enabled && totalPairs >= cdConfig.n_identik.threshold,
    groups,
  };

  return {
    aspekCount    : anomalyAspek.count,
    aspekFlag     : anomalyAspek.flag,
    identikCount  : anomalyIdentik.count,
    identikFlag   : anomalyIdentik.flag,
    identikGroups : anomalyIdentik.groups,
  };
}

// ------------------------------------------------------------
// 10.6 FORMAT LAPORAN ANOMALI
// ------------------------------------------------------------

/**
 * Menghasilkan string laporan anomali yang terformat.
 *
 * @param {DomeAnomalyResult} result
 * @param {'zenith'|'nadir'|'crossdome'} dome
 * @param {string}            isoTimestamp
 * @param {number}            lat
 * @param {number}            lon
 * @returns {string}
 */
function formatAnomalyReport(result, dome, isoTimestamp, lat, lon) {
  const domeLabel = {
    zenith    : 'ZENITH',
    nadir     : 'NADIR',
    crossdome : 'CROSS-DOME',
  }[dome] || dome.toUpperCase();

  const lines = [
    'ANOMALI TERDETEKSI',
    '══════════════════════════════════════════',
    `Waktu  : ${isoTimestamp}`,
    `Kubah  : ${domeLabel}`,
    `Lokasi : ${lat.toFixed(4)}°, ${lon.toFixed(4)}°`,
    '',
    'Tipe 1 — KEPADATAN ASPEK:',
    `  Status : ${result.aspekFlag ? 'AKTIF ⚠' : 'Normal'}`,
    `  Jumlah : ${result.aspekCount} aspek aktif`,
    '',
    'Tipe 2 — SUDUT IDENTIK:',
    `  Status : ${result.identikFlag ? 'AKTIF ⚠' : 'Normal'}`,
    `  Jumlah : ${result.identikCount} pasangan identik`,
  ];

  if (result.identikGroups.length > 0) {
    lines.push('  Simpul :');
    for (const group of result.identikGroups) {
      const pairList = group.pairs
        .map(p => `${p.keyA}—${p.keyB}`)
        .join(', ');
      lines.push(`    → θ ≈ ${group.theta.toFixed(1)}° : ${pairList}`);
    }
  }

  lines.push('══════════════════════════════════════════');

  return lines.join('\n');
}
