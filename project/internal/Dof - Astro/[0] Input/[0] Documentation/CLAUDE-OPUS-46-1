```js
// ============================================================
// BAB 7 — MATRIKS 1 (INTRA-DOME)
// ============================================================

// ------------------------------------------------------------
// 7.1 TIPE SEL
// ------------------------------------------------------------

/**
 * CellType — jenis isi sel Matriks 1
 */
const CELL_TYPE = {
  DIAGONAL   : 'diagonal',   // self vs self
  BLOCKED    : 'blocked',    // entitas tidak di zona yang tepat (×)
  ASPECT     : 'aspect',     // aspek terdeteksi
  THETA_ONLY : 'theta_only', // aktif tapi tidak ada aspek
};

/**
 * MatrixCell — isi satu sel Matriks 1
 * @typedef {Object} MatrixCell
 * @property {number}          i
 * @property {number}          j
 * @property {string}          zone       - 'zenith'|'nadir'|'diagonal'
 * @property {string}          cellType   - CELL_TYPE.*
 * @property {number|null}     theta      - null jika diagonal/blocked
 * @property {AspectMatch|null} aspect
 */

// ------------------------------------------------------------
// 7.2 KALKULASI MATRIKS 1
// ------------------------------------------------------------

/**
 * Menghitung seluruh sel Matriks 1 (15×15 = 225 sel).
 *
 * Layout:
 *   j > i → Zenith Zone (segitiga atas)
 *   j < i → Nadir Zone  (segitiga bawah)
 *   j = i → Diagonal    (hitam)
 *
 * @param {Entity[]}  entities    - array 15 entitas
 * @param {OrbConfig} orbConfig
 * @returns {MatrixCell[][]}      - grid [15][15]
 */
function calcMatrix1(entities, orbConfig) {
  const N    = ENTITY_COUNT;
  const grid = [];

  for (let i = 0; i < N; i++) {
    grid[i] = [];

    for (let j = 0; j < N; j++) {
      // DIAGONAL
      if (i === j) {
        grid[i][j] = {
          i, j,
          zone     : 'diagonal',
          cellType : CELL_TYPE.DIAGONAL,
          theta    : null,
          aspect   : null,
        };
        continue;
      }

      // Tentukan zona berdasarkan posisi relatif i,j
      const zone = j > i ? 'zenith' : 'nadir';

      const eA = entities[i];
      const eB = entities[j];

      // Filter zona
      let active;
      if (zone === 'zenith') {
        active = isZenithSide(eA) && isZenithSide(eB);
      } else {
        active = isNadirSide(eA) && isNadirSide(eB);
      }

      if (!active) {
        grid[i][j] = {
          i, j, zone,
          cellType : CELL_TYPE.BLOCKED,
          theta    : null,
          aspect   : null,
        };
        continue;
      }

      // Hitung θ
      const theta  = gcSep(eA.vec, eB.vec);
      const aspect = matchAspect(theta, orbConfig);

      grid[i][j] = {
        i, j, zone,
        cellType : aspect ? CELL_TYPE.ASPECT : CELL_TYPE.THETA_ONLY,
        theta,
        aspect,
      };
    }
  }

  return grid;
}

// ------------------------------------------------------------
// 7.3 HELPER QUERY MATRIKS 1
// ------------------------------------------------------------

/**
 * Mengambil semua sel dengan aspek aktif dari satu zona.
 *
 * @param {MatrixCell[][]} grid
 * @param {'zenith'|'nadir'} zone
 * @returns {MatrixCell[]}
 */
function getAspectCells(grid, zone) {
  const result = [];
  for (let i = 0; i < ENTITY_COUNT; i++) {
    for (let j = 0; j < ENTITY_COUNT; j++) {
      const cell = grid[i][j];
      if (cell.zone === zone && cell.cellType === CELL_TYPE.ASPECT) {
        result.push(cell);
      }
    }
  }
  return result;
}

/**
 * Mengambil semua sel aktif (aspek maupun theta_only) dari satu zona.
 *
 * @param {MatrixCell[][]} grid
 * @param {'zenith'|'nadir'} zone
 * @returns {MatrixCell[]}
 */
function getActiveCells(grid, zone) {
  const result = [];
  for (let i = 0; i < ENTITY_COUNT; i++) {
    for (let j = 0; j < ENTITY_COUNT; j++) {
      const cell = grid[i][j];
      if (
        cell.zone === zone &&
        (cell.cellType === CELL_TYPE.ASPECT ||
         cell.cellType === CELL_TYPE.THETA_ONLY)
      ) {
        result.push(cell);
      }
    }
  }
  return result;
}
