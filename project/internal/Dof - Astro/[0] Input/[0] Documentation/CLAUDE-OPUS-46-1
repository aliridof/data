## BAB 9: MATRIKS 3 — CROSS-DOME

```js
// ============================================================
// BAB 9 — MATRIKS 3 (CROSS-DOME)
// ============================================================

// ------------------------------------------------------------
// 9.1 TIPE DATA CROSS-DOME
// ------------------------------------------------------------

/**
 * CrossDomeCell — satu sel Matriks 3
 * @typedef {Object} CrossDomeCell
 * @property {number}          iZen      - index entitas Zenith Side
 * @property {number}          iNad      - index entitas Nadir Side
 * @property {string}          keyZen    - key entitas Zenith Side
 * @property {string}          keyNad    - key entitas Nadir Side
 * @property {number}          theta
 * @property {AspectMatch|null} aspect
 * @property {boolean}         transitionalZen
 * @property {boolean}         transitionalNad
 */

/**
 * CrossDomeMatrix — output Matriks 3
 * @typedef {Object} CrossDomeMatrix
 * @property {string[]}         zenithKeys   - label baris
 * @property {string[]}         nadirKeys    - label kolom
 * @property {number[]}         zenithIdx    - index di entities[]
 * @property {number[]}         nadirIdx     - index di entities[]
 * @property {CrossDomeCell[][]} grid        - [R][C]
 * @property {number}           R            - jumlah baris
 * @property {number}           C            - jumlah kolom
 */

// ------------------------------------------------------------
// 9.2 KALKULASI MATRIKS 3
// ------------------------------------------------------------

/**
 * Menghitung Matriks 3 — Cross-Dome.
 *
 * Baris = entitas Zenith Side
 * Kolom = entitas Nadir Side
 *
 * Semua sel selalu terisi (tidak ada sel ×)
 * karena kedua entitas sudah terkonfirmasi di kubah berbeda.
 *
 * @param {Entity[]}         entities
 * @param {OrbConfig}        orbConfig
 * @param {CrossDomeConfig}  cdConfig
 * @returns {CrossDomeMatrix}
 */
function calcMatrix3(entities, orbConfig, cdConfig) {

  // Pisahkan entitas berdasarkan zona
  const zenithSide = [];   // { idx, entity }
  const nadirSide  = [];

  for (let idx = 0; idx < entities.length; idx++) {
    const e = entities[idx];

    if (isZenithSide(e)) {
      // Sertakan transitional di baris hanya jika dikonfigurasi
      if (!e.transitional || cdConfig.show_transitional_row) {
        zenithSide.push({ idx, entity: e });
      }
    } else if (isNadirSide(e)) {
      if (!e.transitional || cdConfig.show_transitional_row) {
        nadirSide.push({ idx, entity: e });
      }
    }
    // Entitas transitional yang dikecualikan tidak masuk ke mana pun
  }

  const R = zenithSide.length;
  const C = nadirSide.length;

  // Tentukan skala ORB untuk cross-dome
  const orbScale = cdConfig.use_same_orb ? 1.0 : cdConfig.cross_orb_scale;

  // Bangun grid [R][C]
  const grid = [];

  for (let r = 0; r < R; r++) {
    grid[r] = [];

    const { idx: iZen, entity: eZen } = zenithSide[r];

    for (let c = 0; c < C; c++) {
      const { idx: iNad, entity: eNad } = nadirSide[c];

      const theta = gcSep(eZen.vec, eNad.vec);

      const aspect = cdConfig.match_aspects
        ? matchAspect(theta, orbConfig, orbScale)
        : null;

      grid[r][c] = {
        iZen,
        iNad,
        keyZen           : eZen.key,
        keyNad           : eNad.key,
        theta,
        aspect,
        transitionalZen  : eZen.transitional,
        transitionalNad  : eNad.transitional,
      };
    }
  }

  return {
    zenithKeys : zenithSide.map(z => z.entity.key),
    nadirKeys  : nadirSide.map(n => n.entity.key),
    zenithIdx  : zenithSide.map(z => z.idx),
    nadirIdx   : nadirSide.map(n => n.idx),
    grid,
    R,
    C,
  };
}

// ------------------------------------------------------------
// 9.3 HELPER QUERY MATRIKS 3
// ------------------------------------------------------------

/**
 * Mengambil semua sel Matriks 3 yang memiliki aspek aktif.
 *
 * @param {CrossDomeMatrix} matrix3
 * @returns {CrossDomeCell[]}
 */
function getCrossDomeAspectCells(matrix3) {
  const result = [];
  for (let r = 0; r < matrix3.R; r++) {
    for (let c = 0; c < matrix3.C; c++) {
      const cell = matrix3.grid[r][c];
      if (cell.aspect !== null) result.push(cell);
    }
  }
  return result;
}

/**
 * Mengambil semua nilai θ dari Matriks 3 (flat array).
 *
 * @param {CrossDomeMatrix} matrix3
 * @returns {number[]}
 */
function getCrossDomeThetaList(matrix3) {
  const result = [];
  for (let r = 0; r < matrix3.R; r++) {
    for (let c = 0; c < matrix3.C; c++) {
      result.push(matrix3.grid[r][c].theta);
    }
  }
  return result;
}
