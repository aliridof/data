/**
 * AspectMatch — hasil matching aspek untuk satu pasangan.
 * @typedef {Object} AspectMatch
 * @property {string} id
 * @property {string} name
 * @property {number} angle
 * @property {string} symbol
 * @property {string} color
 * @property {number} orbUsed      - nilai ORB yang digunakan
 * @property {number} deviation    - |θ - angle| aktual
 */

/**
 * Mencari aspek yang cocok untuk sudut θ.
 *
 * Algoritma:
 *   Iterasi semua aspek (utama + custom aktif).
 *   Hitung deviasi dari setiap aspek.
 *   Pilih aspek dengan deviasi terkecil yang masih ≤ ORB.
 *
 * @param {number}    theta        - sudut separasi aktual (°)
 * @param {OrbConfig} orbConfig    - konfigurasi ORB
 * @param {number}    [orbScale=1] - faktor skala ORB (cross-dome)
 * @returns {AspectMatch|null}
 */
function matchAspect(theta, orbConfig, orbScale = 1) {
  const allAspects = getAllAspects();

  let best          = null;
  let bestDeviation = Infinity;

  for (const aspect of allAspects) {
    const orbBase   = getOrb(aspect.id, orbConfig);
    const orb       = orbBase * orbScale;
    const deviation = Math.abs(theta - aspect.angle);

    if (deviation <= orb && deviation < bestDeviation) {
      bestDeviation = deviation;
      best = {
        id        : aspect.id,
        name      : aspect.name,
        angle     : aspect.angle,
        symbol    : aspect.symbol,
        color     : aspect.color,
        orbUsed   : orb,
        deviation,
      };
    }
  }

  return best;
}
