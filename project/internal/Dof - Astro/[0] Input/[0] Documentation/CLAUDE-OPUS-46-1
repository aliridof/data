 * @property {Object}            anomaly
 */

// ------------------------------------------------------------
// 11.2 KONFIGURASI SISTEM TERPUSAT
// ------------------------------------------------------------

/**
 * SystemConfig — konfigurasi lengkap sistem DOF·ASTRO
 * @typedef {Object} SystemConfig
 * @property {HorizonConfig}   horizon
 * @property {OrbConfig}       orb
 * @property {AnomalyConfig}   anomaly
 * @property {CrossDomeConfig} crossdome
 */

/** @type {SystemConfig} */
const systemConfig = {
  horizon   : { ...DEFAULT_HORIZON_CONFIG },
  orb       : { ...DEFAULT_ORB_CONFIG },
  anomaly   : structuredClone(DEFAULT_ANOMALY_CONFIG),
  crossdome : { ...DEFAULT_CROSSDOME_CONFIG },
};

// ------------------------------------------------------------
// 11.3 FUNGSI UTAMA — runFrame
// ------------------------------------------------------------

/**
 * Menjalankan satu siklus kalkulasi lengkap DOF·ASTRO.
 *
 * Urutan eksekusi:
 *   1. Parse waktu → JD, GMST, LST
 *   2. Hitung posisi 15 entitas
 *   3. Hitung Matriks 1 (intra-dome)
 *   4. Hitung Matriks 2 (θ raw)
 *   5. Hitung Matriks 3 (cross-dome)
 *   6. Deteksi anomali (zenith + nadir + crossdome)
 *   7. Validasi konflik ORB
 *   8. Return FrameResult
 *
 * @param {Object}       timeParams
 * @param {number}       timeParams.year
 * @param {number}       timeParams.month
 * @param {number}       timeParams.day
 * @param {number}       timeParams.hourUTC     - jam desimal UTC
 * @param {Object}       locParams
 * @param {number}       locParams.lat
 * @param {number}       locParams.lon
 * @param {number}       locParams.elev
 * @param {SystemConfig} config
 * @returns {FrameResult}
 */
function runFrame(timeParams, locParams, config) {
  const { year, month, day, hourUTC } = timeParams;
  const { lat, lon, elev }            = locParams;

  // STEP 1: Waktu
  const jd      = calcJD(year, month, day, hourUTC);
  const gmstDeg = calcGMST(jd);
  const lstDeg  = calcLST(gmstDeg, lon);

  const timestamp = buildISOTimestamp(year, month, day, hourUTC);

  // STEP 2: Posisi 15 entitas
  const entities = calcAllEntities(jd, lat, lon, elev, config.horizon);

  // STEP 3: Matriks 1
  const matrix1 = calcMatrix1(entities, config.orb);

  // STEP 4: Matriks 2
  const matrix2 = calcMatrix2(entities, config.orb);

  // STEP 5: Matriks 3 (jika aktif)
  const matrix3 = config.crossdome.enabled
    ? calcMatrix3(entities, config.orb, config.crossdome)
    : null;

  // STEP 6: Anomali
  const anomalyZenith = detectDomeAnomaly(
    matrix1, 'zenith', entities, config.anomaly
  );
  const anomalyNadir = detectDomeAnomaly(
    matrix1, 'nadir', entities, config.anomaly
  );
  const anomalyCrossDome = (matrix3 && config.anomaly.crossdome.enabled)
    ? detectCrossDomeAnomaly(matrix3, config.anomaly)
    : null;

  // STEP 7: Validasi ORB (side-effect: warning saja)
  const orbConflicts = validateOrbConflicts(config.orb);

  return {
    timestamp,
    jd,
    gmstDeg,
    lstDeg,
    horizonThreshold : config.horizon.threshold,
    entities,
    matrix1,
    matrix2,
    matrix3,
    anomaly : {
      zenith    : anomalyZenith,
      nadir     : anomalyNadir,
      crossdome : anomalyCrossDome,
    },
    orbConflicts,
  };
}

// ------------------------------------------------------------
// 11.4 HELPER TIMESTAMP
// ------------------------------------------------------------

/**
 * Membangun ISO 8601 timestamp dari komponen waktu UTC.
 *
 * @param {number} year
 * @param {number} month
 * @param {number} day
 * @param {number} hourUTC   - jam desimal
 * @returns {string}         - "YYYY-MM-DDTHH:MM:SSZ"
 */
function buildISOTimestamp(year, month, day, hourUTC) {
  const h   = Math.floor(hourUTC);
  const m   = Math.floor((hourUTC - h) * 60);
  const s   = Math.floor(((hourUTC - h) * 60 - m) * 60);

  const pad = n => String(n).padStart(2, '0');

  return `${year}-${pad(month)}-${pad(day)}` +
         `T${pad(h)}:${pad(m)}:${pad(s)}Z`;
}

// ------------------------------------------------------------
// 11.5 LIVE MODE — Interval Runner
// ------------------------------------------------------------

/**
 * State live mode
 */
const liveState = {
  running    : false,
  intervalId : null,
  intervalMs : 1000,   // default update setiap 1 detik
};

/**
 * Memulai live mode — runFrame dipanggil otomatis setiap interval.
 *
 * @param {Object}       locParams
 * @param {SystemConfig} config
 * @param {Function}     onFrame    - callback(FrameResult)
 * @param {number}       [intervalMs=1000]
 */
function startLiveMode(locParams, config, onFrame, intervalMs = 1000) {
  if (liveState.running) stopLiveMode();

  liveState.running    = true;
  liveState.intervalMs = intervalMs;

  const tick = () => {
    const now   = new Date();
    const timeP = {
      year    : now.getUTCFullYear(),
      month   : now.getUTCMonth() + 1,
      day     : now.getUTCDate(),
      hourUTC : now.getUTCHours()
               + now.getUTCMinutes() / 60
               + now.getUTCSeconds() / 3600,
    };
    const result = runFrame(timeP, locParams, config);
    onFrame(result);
  };

  tick(); // langsung jalankan sekali
  liveState.intervalId = setInterval(tick, intervalMs);
}

/**
 * Menghentikan live mode.
 */
function stopLiveMode() {
  if (liveState.intervalId) {
    clearInterval(liveState.intervalId);
    liveState.intervalId = null;
  }
  liveState.running = false;
}
