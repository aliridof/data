## BAB 4: PIPELINE KALKULASI POSISI

```js
// ============================================================
// BAB 4 — PIPELINE KALKULASI POSISI
// ============================================================

// ------------------------------------------------------------
// 4.1 KONVERSI WAKTU
// ------------------------------------------------------------

/**
 * Menghitung Julian Day dari komponen waktu UTC.
 * Menggunakan Swiss Ephemeris.
 *
 * @param {number} year
 * @param {number} month   - 1–12
 * @param {number} day     - 1–31
 * @param {number} hour    - desimal UTC (misal 14.5 = 14:30)
 * @returns {number} JD
 */
function calcJD(year, month, day, hour) {
  return swe.julday(year, month, day, hour, swe.GREG_CAL);
}

/**
 * Menghitung Greenwich Mean Sidereal Time (GMST) dalam derajat.
 *
 * @param {number} jd
 * @returns {number} GMST derajat [0, 360)
 */
function calcGMST(jd) {
  const gmstHours = swe.sidtime(jd);   // jam [0, 24)
  return (gmstHours * 15) % 360;
}

/**
 * Menghitung Local Sidereal Time (LST) dalam derajat.
 *
 * @param {number} gmstDeg  - GMST dalam derajat
 * @param {number} lonDeg   - longitude pengamat (° Timur positif)
 * @returns {number} LST derajat [0, 360)
 */
function calcLST(gmstDeg, lonDeg) {
  return ((gmstDeg + lonDeg) % 360 + 360) % 360;
}

// ------------------------------------------------------------
// 4.2 KONVERSI KOORDINAT
// ------------------------------------------------------------

/**
 * Ekliptika → Ekuatorial.
 *
 * @param {number} lonEclDeg   - longitude ekliptika (°)
 * @param {number} latEclDeg   - latitude ekliptika (°)
 * @returns {{ raDeg: number, decDeg: number }}
 */
function eclToEq(lonEclDeg, latEclDeg) {
  const D = ASTRO_CONST.DEG_TO_RAD;
  const R = ASTRO_CONST.RAD_TO_DEG;
  const e = ASTRO_CONST.OBLIQUITY_RAD;

  const lon = lonEclDeg * D;
  const lat = latEclDeg * D;

  const sinDec = Math.sin(lat) * Math.cos(e)
               + Math.cos(lat) * Math.sin(e) * Math.sin(lon);

  const decRad = Math.asin(Math.max(-1, Math.min(1, sinDec)));

  let raRad = Math.atan2(
    Math.sin(lon) * Math.cos(e) - Math.tan(lat) * Math.sin(e),
    Math.cos(lon)
  );
  if (raRad < 0) raRad += 2 * Math.PI;

  return {
    raDeg  : raRad  * R,
    decDeg : decRad * R,
  };
}

/**
 * Ekuatorial → Horizontal.
 *
 * @param {number} raDeg    - Right Ascension (°)
 * @param {number} decDeg   - Declination (°)
 * @param {number} lstDeg   - Local Sidereal Time (°)
 * @param {number} latDeg   - latitude pengamat (°)
 * @returns {{ azDeg: number, altDeg: number }}
 */
function eqToHz(raDeg, decDeg, lstDeg, latDeg) {
  const D = ASTRO_CONST.DEG_TO_RAD;
  const R = ASTRO_CONST.RAD_TO_DEG;

  const ha  = ((lstDeg - raDeg) % 360 + 360) % 360;   // Hour Angle (°)
  const haR = ha  * D;
  const decR = decDeg * D;
  const latR = latDeg * D;

  const sinAlt = Math.sin(latR) * Math.sin(decR)
               + Math.cos(latR) * Math.cos(decR) * Math.cos(haR);

  const altRad = Math.asin(Math.max(-1, Math.min(1, sinAlt)));

  let azRad = Math.atan2(
    -Math.sin(haR),
    Math.tan(decR) * Math.cos(latR) - Math.sin(latR) * Math.cos(haR)
  );
  if (azRad < 0) azRad += 2 * Math.PI;

  return {
    azDeg  : azRad  * R,
    altDeg : altRad * R,
  };
}

/**
 * Horizontal → Vektor 3D (unit vector).
 * Sistem sumbu: +X=Utara, +Y=Timur, +Z=Zenith
 *
 * @param {number} azDeg   - Azimuth (°), 0=Utara, CW
 * @param {number} altDeg  - Altitude (°)
 * @returns {number[]} [x, y, z]
 */
function hzToVec(azDeg, altDeg) {
  const D   = ASTRO_CONST.DEG_TO_RAD;
  const az  = azDeg  * D;
  const alt = altDeg * D;

  return [
    Math.cos(alt) * Math.cos(az),   // x = Utara
    Math.cos(alt) * Math.sin(az),   // y = Timur
    Math.sin(alt),                   // z = Zenith
  ];
}

// ------------------------------------------------------------
// 4.3 KALKULASI POSISI PLANET
// ------------------------------------------------------------

/**
 * Menghitung posisi Planet menggunakan Swiss Ephemeris (WASM).
 * Flag SEFLG_TOPOCTR (32768) menghasilkan posisi toposentrik.
 *
 * @param {number}        jd
 * @param {string}        key        - 'SUN'|'MON'|...|'PLU'
 * @param {number}        lstDeg
 * @param {number}        latDeg
 * @param {HorizonConfig} hConfig
 * @returns {Entity}
 */
function calcPlanetEntity(jd, key, lstDeg, latDeg, hConfig) {
  const sweId  = SWE_IDS[key];
  const TOPOCTR = 32768;

  const result = swe.calc_ut(jd, sweId, TOPOCTR);
  // result = { lon, lat, dist, ... }  (koordinat ekliptika)

  const { raDeg, decDeg } = eclToEq(result.lon, result.lat);
  const { azDeg, altDeg } = eqToHz(raDeg, decDeg, lstDeg, latDeg);
  const vec                = hzToVec(azDeg, altDeg);

  const { isAbove, transitional } = evalHorizon(altDeg, hConfig);

  return {
    key,
    type         : ENTITY_TYPE.PLANET,
    vec,
    az           : azDeg,
    alt          : altDeg,
    isAbove,
    transitional,
    subLat       : decDeg,     // sub-point ≈ Dec untuk planet
    subLon       : raDeg,
  };
}

// ------------------------------------------------------------
// 4.4 KALKULASI POSISI SIRIUS
// ------------------------------------------------------------

// Koordinat fallback Sirius (J2000)
const SIRIUS_FALLBACK = { raDeg: 101.287, decDeg: -16.716 };

/**
 * Menghitung posisi Sirius (bintang tetap).
 *
 * @param {number}        jd
 * @param {number}        lstDeg
 * @param {number}        latDeg
 * @param {HorizonConfig} hConfig
 * @returns {Entity}
 */
function calcSiriusEntity(jd, lstDeg, latDeg, hConfig) {
  let raDeg, decDeg;

  try {
    const result = swe.fixstar2_ut('Sirius', jd, 0);
    const eq     = eclToEq(result.lon, result.lat);
    raDeg        = eq.raDeg;
    decDeg       = eq.decDeg;
  } catch (e) {
    // Fallback ke koordinat J2000
    raDeg  = SIRIUS_FALLBACK.raDeg;
    decDeg = SIRIUS_FALLBACK.decDeg;
  }

  const { azDeg, altDeg } = eqToHz(raDeg, decDeg, lstDeg, latDeg);
  const vec                = hzToVec(azDeg, altDeg);
  const { isAbove, transitional } = evalHorizon(altDeg, hConfig);

  return {
    key          : 'SUI',
    type         : ENTITY_TYPE.FIXED_STAR,
    vec,
    az           : azDeg,
    alt          : altDeg,
    isAbove,
    transitional,
    subLat       : decDeg,
    subLon       : raDeg,
  };
}

// ------------------------------------------------------------
// 4.5 KALKULASI SEMUA ENTITAS (ENTRY POINT)
// ------------------------------------------------------------

/**
 * Menghitung posisi seluruh 15 entitas.
 *
 * @param {number}        jd          - Julian Day
 * @param {number}        latDeg      - latitude pengamat
 * @param {number}        lonDeg      - longitude pengamat
 * @param {number}        elevM       - elevasi pengamat (meter)
 * @param {HorizonConfig} hConfig
 * @returns {Entity[]}               - array 15 entitas (urutan ENTITY_KEYS)
 */
function calcAllEntities(jd, latDeg, lonDeg, elevM, hConfig) {
  // Set toposentrik
  swe.set_topo(lonDeg, latDeg, elevM);

  const gmstDeg = calcGMST(jd);
  const lstDeg  = calcLST(gmstDeg, lonDeg);

  const entities = [];

  for (const key of ENTITY_KEYS) {
    let entity;

    if (key === 'TZ' || key === 'TN' || key === 'CZ' || key === 'CN') {
      entity = makePersonaEntity(key, latDeg, lonDeg);

    } else if (key === 'SUI') {
      entity = calcSiriusEntity(jd, lstDeg, latDeg, hConfig);

    } else {
      entity = calcPlanetEntity(jd, key, lstDeg, latDeg, hConfig);
    }

    entities.push(entity);
  }

  return entities;
}
