## BAB 2: ENTITAS & KLASIFIKASI ZONA

```js
// ============================================================
// BAB 2 — ENTITAS & KLASIFIKASI ZONA
// ============================================================

// ------------------------------------------------------------
// 2.1 SKEMA ENTITAS (OUTPUT KALKULASI)
// ------------------------------------------------------------

/**
 * Entity Object (hasil kalkulasi posisi)
 * @typedef {Object} Entity
 * @property {string}   key          - 'TZ'|'TN'|'CZ'|...|'SUI'
 * @property {string}   type         - ENTITY_TYPE.*
 * @property {number[]} vec          - [x, y, z] unit vector
 * @property {number}   az           - azimuth derajat
 * @property {number}   alt          - altitude derajat
 * @property {boolean}  isAbove      - Alt >= H_threshold
 * @property {boolean}  transitional - |Alt - H_threshold| < BAND
 * @property {number}   subLat       - sub-point latitude
 * @property {number}   subLon       - sub-point longitude
 */

// ------------------------------------------------------------
// 2.2 FACTORY ENTITAS STATIS (PERSONA)
// ------------------------------------------------------------

/**
 * Membuat entitas Persona yang vektornya selalu statis.
 * TZ dan CZ memiliki vektor [0,0,+1].
 * TN dan CN memiliki vektor [0,0,-1].
 *
 * @param {string} key       - 'TZ'|'TN'|'CZ'|'CN'
 * @param {number} lat       - latitude pengamat (°)
 * @param {number} lon       - longitude pengamat (°)
 * @returns {Entity}
 */
function makePersonaEntity(key, lat, lon) {
  const isZenith = (key === 'TZ' || key === 'CZ');

  const vec = isZenith ? [0, 0, 1] : [0, 0, -1];
  const alt = isZenith ? 90 : -90;

  let subLat, subLon;
  if (key === 'TZ') {
    subLat = lat;
    subLon = lon;
  } else if (key === 'TN') {
    subLat = -lat;
    subLon = lon >= 0 ? lon - 180 : lon + 180;
  } else {
    // CZ dan CN: sub-point dari RA/Dec (tidak relevan untuk vektor)
    subLat = null;
    subLon = null;
  }

  return {
    key,
    type         : key === 'TZ' || key === 'TN'
                     ? ENTITY_TYPE.PERSONA_STATIC
                     : ENTITY_TYPE.PERSONA_DYNAMIC,
    vec,
    az           : isZenith ? 0 : 180,
    alt,
    isAbove      : isZenith,
    transitional : false,   // persona tidak pernah transitional
    subLat,
    subLon,
  };
}

// ------------------------------------------------------------
// 2.3 KLASIFIKASI ZONA
// ------------------------------------------------------------

/**
 * Apakah entitas masuk Zenith Side (Kubah Atas)?
 *
 * Persona TZ/CZ → selalu TRUE
 * Persona TN/CN → selalu FALSE
 * Planet/Bintang → TRUE jika isAbove
 *
 * @param {Entity} entity
 * @returns {boolean}
 */
function isZenithSide(entity) {
  if (entity.key === 'TZ' || entity.key === 'CZ') return true;
  if (entity.key === 'TN' || entity.key === 'CN') return false;
  return entity.isAbove;
}

/**
 * Apakah entitas masuk Nadir Side (Kubah Bawah)?
 *
 * Persona TN/CN → selalu TRUE
 * Persona TZ/CZ → selalu FALSE
 * Planet/Bintang → TRUE jika !isAbove
 *
 * @param {Entity} entity
 * @returns {boolean}
 */
function isNadirSide(entity) {
  if (entity.key === 'TN' || entity.key === 'CN') return true;
  if (entity.key === 'TZ' || entity.key === 'CZ') return false;
  return !entity.isAbove;
}

/**
 * Apakah pasangan (A, B) adalah pasangan Cross-Dome?
 * Cross-Dome: satu di Zenith, satu di Nadir.
 *
 * @param {Entity} entityA
 * @param {Entity} entityB
 * @returns {boolean}
 */
function isCrossDomePair(entityA, entityB) {
  return (
    (isZenithSide(entityA) && isNadirSide(entityB)) ||
    (isNadirSide(entityA)  && isZenithSide(entityB))
  );
}

// ------------------------------------------------------------
// 2.4 EVALUASI isAbove DENGAN H_threshold
// ------------------------------------------------------------

/**
 * Menentukan status isAbove dan transitional
 * untuk entitas Planet atau Bintang Tetap.
 *
 * @param {number} alt              - altitude aktual (°)
 * @param {HorizonConfig} hConfig
 * @returns {{ isAbove: boolean, transitional: boolean }}
 */
function evalHorizon(alt, hConfig) {
  const { threshold } = hConfig;
  const isAbove       = alt >= threshold;
  const transitional  = Math.abs(alt - threshold) < TRANSITIONAL_BAND;

  return { isAbove, transitional };
}
